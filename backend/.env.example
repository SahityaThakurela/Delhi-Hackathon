# backend
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/postgres # Supabase direct or session-pooler string
REDIS_URL=rediss://default:TOKEN@HOST:6379 # Upstash
S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3 # or AWS S3
S3_BUCKET=kyro-documents
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=ap-south-1
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1536
JWT_SECRET=change-me-to-a-secure-random-secret
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
NVD_API_KEY=
NCBI_API_KEY=
DEMO_PASSWORD=kyro-demo-2026
