# =====================================================================
# KYRO - AI-Powered Healthcare Vendor Intelligence Platform
# Environment Variables Specification (.env.example)
# Team LUNA | Hack-4-Crown
#
# DO NOT COMMIT SENSITIVE CREDENTIALS TO VERSION CONTROL
# =====================================================================

# ---------------------------------------------------------------------
# Database & Cache (PostgreSQL with pgvector and Redis)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kyro
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# S3-Compatible Object Storage (Documents & Reports)
# Supabase Storage or AWS S3 / MinIO
# ---------------------------------------------------------------------
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_BUCKET=kyro-documents
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=ap-south-1

# ---------------------------------------------------------------------
# OpenAI & AI Orchestration (P2 Intelligence)
# ---------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1536

# ---------------------------------------------------------------------
# Core Security & Authentication (Owned by P1)
# ---------------------------------------------------------------------
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------
# Optional External API Keys (Public Intelligence Sources)
# ---------------------------------------------------------------------
NVD_API_KEY=
NCBI_API_KEY=

# ---------------------------------------------------------------------
# Demo & Offline Replay Flags
# ---------------------------------------------------------------------
DEMO_REPLAY=0
DEMO_PASSWORD=kyro-demo-secret
